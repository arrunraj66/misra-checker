##### rule 8.13
summary: ignored (merged)

--- bad: a pointer that is advanced and read, never written through
int sum(int *p, int n) /*@V*/
{
    int s = 0;
    while (n-- > 0) { s += *p++; }
    return s;
}

--- bad: a structure pointer that is only read
struct pair { int x; int y; };
int first(struct pair *p) { return p->x; } /*@V*/

--- ok: a structure pointer that is written through
struct pair { int x; int y; };
void set(struct pair *p) { p->x = 1; }

--- ok: both pointers are written through
void swap(int *a, int *b) { int t = *a; *a = *b; *b = t; }

--- ok: the pointer is returned as a pointer to non-const
int *same(int *p) { return p; }

--- ok: written through an index
void fill(int *p) { p[0] = 1; }

--- ok: read-modify-write through the pointer
void inc(int *p) { (*p)++; }

--- bad: a pointer passed to a function that only needs const
int peek(const int *p);
int use(int *p) { return peek(p); } /*@V*/

--- ok: a pointer advanced and written through
void zero(int *p, int n) { while (n-- > 0) { *p++ = 0; } }

--- ok: a pointer passed on to a function that may modify it
void sink(int *p);
int forward(int *p) { sink(p); return 0; }

##### rule 9.1
summary: ignored (merged)

--- ok: array with a complete initializer
int f(void) { int a[3] = { 0 }; return a[1]; }

--- ok: written in a loop and then read
int f(int n)
{
    int s;
    int i;
    s = 0;
    for (i = 0; i < n; i++) { s += i; }
    return s;
}

--- ok: sizeof does not read the object
int f(void) { int x; return (int)sizeof(x); }

--- ok: assigned in every branch of an if/else chain
int f(int c)
{
    int x;
    if (c == 1) { x = 1; } else if (c == 2) { x = 2; } else { x = 3; }
    return x;
}

--- bad: the value is passed to a function before it is set
void use(int v);
void f(void)
{
    int x;
    use(x); /*@V*/
}

--- bad: a compound assignment reads first
int f(void)
{
    int x;
    x += 1; /*@V*/
    return x;
}

--- bad: assigned only in some switch clauses without default
int f(int c)
{
    int x;
    switch (c)
    {
        case 1: x = 1; break;
        case 2: x = 2; break;
    }
    return x; /*@V*/
}

##### rule 10.3
summary: ignored (merged)

--- ok: widening within a category and constants
int f(char c, int i)
{
    long l = i;
    char k = 'a';
    unsigned char u = 200;
    (void)l; (void)c; (void)k; (void)u;
    return 0;
}

--- bad: a character assigned to an int (a different essential type category)
void g(char c)
{
    int j = c; /*@V*/
    (void)j;
}

--- bad: a signed value assigned to an unsigned object
void f(int i)
{
    unsigned int u = i; /*@V*/
    (void)u;
}

--- bad: an int assigned to a char
void g(int i)
{
    char c = i; /*@V*/
    (void)c;
}

--- bad: a floating value assigned to an integer
void h(double d)
{
    int n = d; /*@V*/
    (void)n;
}

##### rule 10.4
summary: ignored (merged)

--- ok: comparisons of the same category
int f(char a, char b) { return a == b; }
int g(unsigned char a, unsigned int b) { return a < b; }

--- ok: operands that are constants
int h(unsigned int u) { return u > 10; }

--- bad: two different enumerations compared
enum color { RED, GREEN };
enum shape { ROUND, SQUARE };
int f(enum color c, enum shape s) { return c == s; } /*@V*/

--- bad: unsigned with signed variables
int g(unsigned int u, int i) { return u < i; } /*@V*/

##### rule 11.5
summary: ignored (merged)

--- bad: the result of a function returning void pointer assigned to an int pointer
void *get(void);
void f(void)
{
    int *p = get(); /*@V*/
    (void)p;
}

--- ok: stored in another void pointer
void *get(void);
void f(void)
{
    void *p = get();
    (void)p;
}

##### rule 11.9
summary: ignored (merged)

--- bad: zero passed where a pointer is expected
void take(int *p);
void f(void) { take(0); } /*@V*/

--- bad: a home made null macro
#define MYNULL ((void *)0)
int *p = MYNULL; /*@V*/

--- ok: NULL passed as an argument
#include <stddef.h>
void take(int *p);
void f(void) { take(NULL); }

##### rule 12.4
summary: ignored (merged)

--- ok: a signed expression and a result that fits
int a = 2147483646 + 1;
unsigned int b = 4000000000U + 200000000U;

--- ok: the common mask idiom that shifts bits out of an all-ones value
unsigned int mask = ~0u << 6;

--- gap: a left shift that discards bits (whether this is wrap-around is undecided; shifts are not evaluated)
unsigned int a = 0x80000000U << 1; /*@V*/

##### rule 13.2
summary: ignored (merged)

--- ok: different variables in one expression
int f(int i, int j) { return i + j++; }

--- ok: function arguments that do not conflict
int add(int a, int b);
int f(int i, int j) { return add(i, j + 1); }

--- ok: a variable modified in one statement and read in the next
int f(int i)
{
    i++;
    return i;
}

##### rule 14.2
summary: ignored (merged)

--- ok: a step other than one
void f(int n) { int i; for (i = 0; i < n; i += 2) { } }

--- ok: a pointer walking a list
struct node { struct node *next; };
void f(struct node *head)
{
    struct node *p;
    for (p = head; p != 0; p = p->next) { }
}

--- ok: a counting down loop with the counter only in the clauses
void f(int n) { int i; for (i = n; i != 0; i--) { } }

##### rule 15.6
summary: ignored (merged)

--- bad: a do-while body without braces
void f(int x)
{
    do x--; while (x > 0); /*@V*/
}

--- bad: an infinite for with a single statement
void g(int *p)
{
    for (;;) (*p)++; /*@V*/
}

--- ok: an else-if chain with braces everywhere
int f(int x) { if (x > 1) { return 1; } else if (x > 0) { return 0; } else { return -1; } }

##### rule 16.3
summary: ignored (merged)

--- ok: a clause that is a block ending in break
int f(int v)
{
    int r = 0;
    switch (v)
    {
        case 1:
        {
            r = 1;
            break;
        }
        default:
            break;
    }
    return r;
}

--- bad: a clause that ends in continue inside a loop
int f(int n)
{
    int i;
    int r = 0;
    for (i = 0; i < n; i++)
    {
        switch (i)
        {
            case 1: /*@V*/
                r++;
                continue;
            default:
                break;
        }
    }
    return r;
}

##### rule 17.7
summary: ignored (merged)

--- ok: a library call cast to void
#include <string.h>
void f(char *d, const char *s) { (void)strcpy(d, s); }

--- ok: the call is used in a condition
int g(void);
void f(void) { if (g() > 0) { } }

--- bad: a call whose result is dropped inside a block
int g(void);
void f(int c)
{
    if (c)
    {
        g(); /*@V*/
    }
}

##### rule 18.4
summary: ignored (merged)

--- bad: the difference of two pointers
long d(int *p, int *q) { return p - q; } /*@V*/

--- ok: subscript instead of arithmetic
int f(int *p, int i) { return p[i]; }

##### rule 20.7
summary: ignored (merged)

--- ok: a conditional with every parameter parenthesized
#define MAX(a, b) (((a) > (b)) ? (a) : (b))
int m = MAX(1, 2);

--- ok: a parameter inside an index with parentheses
int arr[4];
#define ELEM(i) arr[(i)]
int e = ELEM(2);

--- bad: a parameter in a comparison without parentheses
#define BIGGER(a, b) a > b /*@V*/
int c = BIGGER(2, 1);

##### rule 22.1
summary: ignored (merged)

--- ok: an allocation freed after use on every path
#include <stdlib.h>
int f(int n)
{
    char *p = malloc(8);
    int r = 0;
    if (p != 0)
    {
        p[0] = (char)n;
        r = p[0];
        free(p);
    }
    return r;
}

--- ok: the allocation is stored in a structure that outlives the function
#include <stdlib.h>
struct holder { char *buf; };
void f(struct holder *h) { h->buf = malloc(8); }

--- ok: realloc keeps the owner
#include <stdlib.h>
void f(void)
{
    char *p = malloc(8);
    p = realloc(p, 16);
    free(p);
}

--- bad: the owner is overwritten, losing the allocation
#include <stdlib.h>
void f(void)
{
    char *p = malloc(8); /*@V*/
    p = 0;
}

##### rule 22.2
summary: ignored (merged)

--- ok: freeing a null pointer constant
#include <stdlib.h>
void f(void) { free(0); }

--- ok: freeing after reassignment
#include <stdlib.h>
void f(void)
{
    char *p = malloc(4);
    free(p);
    p = malloc(4);
    free(p);
}
