##### rule 8.1
summary: ignored (merged)

--- bad: implicit int on a static object
static counter = 0; /*@V*/

--- bad: const without a type
const limit = 4; /*@V*/

--- ok: unsigned, long and short alone are explicit types
unsigned a;
long b;
short c;
signed d;

--- bad: main without a return type
main(void) { return 0; } /*@V*/

##### rule 8.2
summary: ignored (merged)

--- bad: a prototype with only a type
void f(int); /*@V*/

--- ok: a variadic prototype with a named first parameter
int p(const char *fmt, ...);

--- ok: array and function pointer parameters with names
void f(int a[], int (*cb)(int x));

--- ok: void parameter list
int f(void);

--- bad: a definition with an empty parameter list
int f() { return 0; } /*@V*/

##### rule 8.3
summary: ignored (merged)

--- bad: an extern object declared with different types in two files
=== a.c
int level = 1;
=== b.c
extern long level; /*@V*/
long get(void) { return level; }

--- ok: the same declaration repeated in two files through a header
=== h.h
extern int level;
=== a.c
#include "h.h"
int level = 1;
=== b.c
#include "h.h"
int get(void) { return level; }

--- bad: a parameter name differs in two prototypes
int f(int a, int b);
int f(int a, int c); /*@V*/

##### rule 8.4
summary: ignored (merged)

--- ok: a prior declaration from an included header
=== h.h
int get(void);
extern int level;
=== a.c
#include "h.h"
int level = 3;
int get(void) { return level; }

--- ok: an inline function that is static
static inline int sq(int a) { return a * a; }

--- bad: a non-static inline function definition with no declaration
inline int sq(int a) { return a * a; } /*@V*/

##### rule 8.5
summary: ignored (merged)

--- bad: a function declared in two source files
=== a.c
int helper(void);
int run(void) { return helper(); }
=== b.c
int helper(void); /*@V*/
int helper(void) { return 1; }

##### rule 8.6
summary: ignored (merged)

--- ok: an extern declaration that nothing uses
=== a.c
extern int unused_level;
int run(void) { return 0; }
=== b.c
int other(void) { return 1; }

--- bad: an object used in one file and defined nowhere
=== a.c
extern int missing;
int run(void) { return missing; } /*@V*/
=== b.c
int other(void) { return 1; }

--- ok: a function used only through a pointer in another file
=== a.c
int handler(int x) { return x; }
=== b.c
int handler(int x);
int (*table[1])(int) = { handler };

##### rule 8.7
summary: ignored (merged)

--- bad: a header declaration that no other file uses
=== h.h
int only_here(void);
=== a.c
#include "h.h"
int only_here(void) { return 1; } /*@V*/
int run(void) { return only_here(); }
=== b.c
int other(void) { return 2; }

--- ok: an object accessed from two files
=== a.c
int shared = 1;
int get(void);
int main(void) { return get(); }
=== b.c
extern int shared;
int get(void) { return shared; }

##### rule 8.8
summary: ignored (merged)

--- bad: an extern redeclaration of a static object
static int level;
extern int level; /*@V*/

--- ok: static function declared and defined static
static int f(void);
static int f(void) { return 1; }
int g(void) { return f(); }

##### rule 8.9
summary: ignored (merged)

--- ok: a static whose address is stored at file scope as well
static int level;
static int *ptr = &level;
void f(void) { level = 1; }

--- ok: a static used in a macro by two functions
static int level;
#define BUMP() (level++)
void f(void) { BUMP(); }
void g(void) { BUMP(); }

--- bad: a static function-local use through a nested block
static int level; /*@V*/
void f(int c)
{
    if (c) { level = 1; }
}

--- ok: a static unused anywhere (an unreferenced object is another rule)
static int level;

##### rule 8.10
summary: ignored (merged)

--- bad: extern inline definition
extern inline int sq(int a) { return a * a; } /*@V*/

--- ok: a declaration only of a static inline function
static inline int sq(int a);
static inline int sq(int a) { return a * a; }

##### rule 8.11
summary: ignored (merged)

--- bad: extern char array without size
extern char buffer[]; /*@V*/

--- ok: extern pointer
extern char *buffer;

--- ok: extern array of a typedef with size
extern int table[8];

--- ok: flexible array member in a structure
struct s { int n; int d[]; };

##### rule 8.12
summary: ignored (merged)

--- bad: implicit enumerator equals a later explicit one
enum e { A = 0, B, C = 1 }; /*@V*/

--- ok: all explicit and duplicated by choice
enum e { A = 1, B = 1 };

--- ok: negative start then implicit
enum e { A = -1, B, C };

--- bad: implicit equals the first explicit value of a negative start
enum e { A, B = -1, C }; /*@V*/

##### rule 8.13
summary: ignored (merged)

--- bad: a pointer only compared with null
int f(int *p) { return p != 0; } /*@V*/

--- gap: pointer to pointer that is only read (only the first level of pointers is examined)
int f(char **argv) { return argv[0][0]; } /*@V*/

--- ok: a pointer stored into a pointer to non-const
int *g;
void f(int *p) { g = p; }

--- ok: a pointer passed to a function that may write
void fill(int *out);
void f(int *p) { fill(p); }

--- bad: volatile register read only
int f(volatile int *reg) { return *reg; } /*@V*/

--- ok: function pointer parameters are not data pointers
int f(int (*cb)(int)) { return cb(1); }

--- bad: pointer to a const-qualified struct member read
struct s { int a; };
int f(struct s *p) { return p->a + 1; } /*@V*/

--- ok: written through a member
struct s { int a; };
void f(struct s *p) { p->a = 1; }

--- ok: member of the pointee modified through increment
struct s { int a; };
void f(struct s *p) { p->a++; }

##### rule 8.14
summary: ignored (merged)

--- bad: restrict member in a structure
struct s { int *restrict p; }; /*@V*/

--- ok: the word restrict inside an identifier
int restricted;
int restrict_count;

--- bad: restrict through a typedef
typedef int *restrict rp_t; /*@V*/

##### rule 9.1
summary: ignored (merged)

--- bad: increment of a never initialised object
int f(void)
{
    int x;
    x++; /*@V*/
    return x;
}

--- ok: assigned in a for initialiser
int f(int n)
{
    int i;
    int s = 0;
    for (i = 0; i < n; i++) { s += i; }
    return s;
}

--- ok: assigned by a do-while body before the read
int f(void)
{
    int x;
    do { x = 1; } while (0);
    return x;
}

--- ok: a static object is zero initialised
int f(void)
{
    static int x;
    return x;
}

--- gap: struct member read before it is written (only scalar objects are tracked)
struct s { int a; int b; };
int f(void)
{
    struct s v;
    v.a = 1;
    return v.b; /*@V*/
}

--- ok: struct passed by address is initialised there
struct s { int a; };
void init(struct s *p);
int f(void)
{
    struct s v;
    init(&v);
    return v.a;
}

--- bad: switch with default that forgets to assign
int f(int c)
{
    int x;
    switch (c)
    {
        case 1: x = 1; break;
        default: break;
    }
    return x; /*@V*/
}

--- ok: assigned in both arms of a conditional operator statement
int f(int c)
{
    int x;
    if (c) { x = 1; } else { x = 0; }
    return x + 1;
}

##### rule 9.2
summary: ignored (merged)

--- ok: structure with a nested array fully braced
struct s { int v[2]; int w; };
struct s a = { { 1, 2 }, 3 };

--- bad: structure with a nested array not braced
struct s { int v[2]; int w; };
struct s a = { 1, 2, 3 }; /*@V*/

--- ok: array of structures each braced
struct p { int x; int y; };
struct p t[2] = { { 1, 2 }, { 3, 4 } };

--- ok: string initialiser of a char member
struct s { char name[4]; int id; };
struct s a = { "ab", 1 };

--- ok: empty-style zero initialiser of nested aggregate
int m[2][2] = { { 0 } };

##### rule 9.3
summary: ignored (merged)

--- bad: two of three elements
int a[3] = { 1, 2 }; /*@V*/

--- ok: designated initialisers
int a[3] = { [0] = 1, [1] = 2, [2] = 3 };

--- ok: a string initialiser shorter than the array
char s[8] = "ab";

--- ok: a structure initialised partially (arrays only for this rule)
struct s { int a; int b; };
struct s v = { 1 };

--- bad: nested array row incomplete
int m[2][2] = { { 1, 2 }, { 3 } }; /*@V*/

##### rule 9.4
summary: ignored (merged)

--- bad: a designator repeated after other elements
int a[3] = { [0] = 1, [1] = 2, [0] = 3 }; /*@V*/

--- ok: designators on different members
struct s { int a; int b; } v = { .a = 1, .b = 2 };

##### rule 9.5
summary: ignored (merged)

--- ok: designators with an explicit size
int a[4] = { [1] = 1, [3] = 2 };

--- bad: two array designators and no size
int a[] = { [1] = 1, [3] = 2 }; /*@V*/
