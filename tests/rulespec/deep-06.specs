##### rule 13.1
summary: ignored (merged)

--- ok: constants, sizeof and arithmetic in an initializer list
int a = 1, b = 2;
int t[3] = { 1, sizeof(int), 2 + 3 };

--- bad: a volatile read in an initializer list
volatile int reg;
void f(void)
{
    int t[2] = { reg, 1 }; /*@V*/
    (void)t;
}

--- bad: a decrement in a structure initializer
struct s { int a; int b; };
void f(int n)
{
    struct s v = { n--, 1 }; /*@V*/
    (void)v;
}

--- ok: a parenthesised pure expression
void f(int a, int b)
{
    int t[2] = { (a + b) * 2, a - b };
    (void)t;
}

##### rule 13.2
summary: ignored (merged)

--- bad: assignment from a post-incremented self
void f(int i) { i = i++; } /*@V*/

--- bad: two post-increments of one variable added
int f(int i) { return i++ + i++; } /*@V*/

--- bad: call arguments that read and modify the same variable
int g(int a, int b);
int f(int i) { return g(i, i++); } /*@V*/

--- ok: the right operand of && is sequenced after the left
int f(int a, int b) { return (a > 0) && (b = a) > 0; }

--- ok: conditional operator branches modify separately
int f(int c, int i) { return c ? i++ : i--; }

--- ok: different array elements through different variables
void f(int *t, int i, int j) { t[i] = t[j] + 1; }

--- bad: pointer increment and use in one expression
int f(int *p) { return *p++ + *p; } /*@V*/

##### rule 13.3
summary: ignored (merged)

--- ok: an increment alone in a condition comparison
int f(int i) { return i++ > 1; }

--- bad: an increment as a call argument
int g(int a);
int f(int i) { return g(i++); } /*@V*/

--- bad: a post-increment in an indexed store
void f(int *t, int i) { t[i++] = 0; } /*@V*/

--- ok: pre-increment as a statement
void f(int i) { ++i; (void)i; }

##### rule 13.4
summary: ignored (merged)

--- bad: assignment returned
int f(int a) { int b; return b = a; } /*@V*/

--- bad: assignment in a loop condition
int f(int *p)
{
    int c;
    int n = 0;
    while ((c = *p++) != 0) { n += c; } /*@V*/
    return n;
}

--- ok: compound assignment as a statement
void f(int a) { a += 2; (void)a; }

--- ok: assignments in separate for clauses
void f(int n)
{
    int i, j;
    for (i = 0, j = n; i < j; i++) { }
}

##### rule 13.5
summary: ignored (merged)

--- ok: a pointer check protects the member read
struct s { int v; };
int f(struct s *p) { return (p != 0) && (p->v > 0); }

--- bad: a decrement on the right of ||
int f(int a, int b) { return (a > 0) || (b-- > 0); } /*@V*/

--- bad: a volatile structure member on the right
struct r { volatile int v; };
int f(struct r *p, int a) { return (a > 0) && (p->v > 0); } /*@V*/

--- ok: both operands pure comparisons
int f(int a, int b) { return (a > 0) && (b > 0) && (a != b); }

##### rule 13.6
summary: ignored (merged)

--- ok: sizeof of an array element and a dereference
unsigned long f(int *p, int i) { return sizeof(p[i]) + sizeof(*p); }

--- bad: pre-increment inside sizeof
unsigned long f(int i) { return sizeof(++i); } /*@V*/

--- ok: sizeof of a type name
unsigned long n = sizeof(unsigned int);

##### rule 14.1
summary: ignored (merged)

--- bad: float counter stepped with an assignment
void f(void)
{
    float x;
    for (x = 0.0f; x < 1.0f; x = x + 0.1f) { } /*@V*/
}

--- ok: float bound with an integer counter
void f(float limit)
{
    int i;
    for (i = 0; i < limit; i++) { }
}

--- bad: long double counter
void f(void)
{
    long double x;
    for (x = 0.0L; x < 1.0L; x += 0.25L) { } /*@V*/
}

--- gap: a floating counter in a while loop (only for statements are examined)
void f(void)
{
    float x = 0.0f;
    while (x < 1.0f) { x += 0.1f; } /*@V*/
}

##### rule 14.2
summary: ignored (merged)

--- ok: counter only read in the body
int f(int *t, int n)
{
    int i;
    int s = 0;
    for (i = 0; i < n; i++) { s += t[i]; }
    return s;
}

--- ok: C99 declaration in the first clause
int f(int n)
{
    int s = 0;
    for (int i = 0; i < n; i++) { s += i; }
    return s;
}

--- bad: counter modified in the body through compound assignment
void f(int n)
{
    int i;
    for (i = 0; i < n; i++) { i += 2; } /*@V*/
}

--- ok: an empty first clause is allowed
void f(int i, int n)
{
    for (; i < n; i++) { }
}

--- ok: nested loops with different counters
void f(int n)
{
    int i, j;
    for (i = 0; i < n; i++) { for (j = 0; j < n; j++) { } }
}

##### rule 14.3
summary: ignored (merged)

--- bad: an always true if
void f(int a)
{
    if (1) { a++; } /*@V*/
}

--- bad: a sizeof based condition
void f(int a)
{
    if (sizeof(int) == 4) { a++; } /*@V*/
}

--- ok: a condition with an unknown operand and a constant
int f(int a) { return a && 0; }

--- ok: infinite for loop without a condition
void f(void) { for (;;) { } }

##### rule 14.4
summary: ignored (merged)

--- bad: while(1) is not essentially Boolean
void f(void) { while (1) { } } /*@V*/

--- ok: for(;;)
void f(void) { for (;;) { } }

--- ok: Boolean variable and double negation
int f(_Bool b, int x) { if (b) { return 1; } if (!!x) { return 2; } return 0; }

--- bad: integer variable in a for condition
void f(int n) { for (; n; n--) { } } /*@V*/

--- bad: floating variable as a condition
int f(float x) { if (x) { return 1; } return 0; } /*@V*/

##### rule 15.1
summary: ignored (merged)

--- bad: goto in a nested block
void f(int a)
{
    if (a) { goto end; } /*@V*/
end:
    a = 0;
}

--- ok: a switch label and a case are not gotos
int f(int v) { switch (v) { case 1: return 1; default: return 0; } }

##### rule 15.2
summary: ignored (merged)

--- ok: a forward goto past a loop
void f(int n)
{
    while (n) { if (n == 3) { goto out; } n--; }
out:
    n = 0;
}

--- bad: a backward goto forming a loop
void f(int n)
{
top:
    n--;
    if (n > 0) { goto top; } /*@V*/
}

##### rule 15.3
summary: ignored (merged)

--- bad: a jump into a block of a loop
void f(int n)
{
    goto inside; /*@V*/
    while (n)
    {
inside:
        n--;
    }
}

--- ok: a jump out of a nested block to the function level
void f(int n)
{
    while (n) { if (n == 2) { goto done; } n--; }
done:
    n = 0;
}

##### rule 15.4
summary: ignored (merged)

--- ok: one break in each of two nested loops
void f(int n, int m)
{
    int i, j;
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < m; j++)
        {
            if (j == 3) { break; }
        }
        if (i == 2) { break; }
    }
}

--- ok: continue does not count
void f(int n)
{
    int i;
    for (i = 0; i < n; i++)
    {
        if (i == 1) { continue; }
        if (i == 2) { continue; }
    }
}

--- bad: two breaks in a while loop
void f(int n)
{
    while (n) /*@V*/
    {
        if (n == 1) { break; }
        if (n == 2) { break; }
        n--;
    }
}

--- ok: breaks inside a switch inside a loop leave the switch
void f(int n)
{
    while (n)
    {
        switch (n)
        {
            case 1: n = 0; break;
            default: n--; break;
        }
    }
}

##### rule 15.5
summary: ignored (merged)

--- bad: a return in a nested block at the end
int f(int a) /*@V*/
{
    if (a) { return 1; }
    return 0;
}

--- ok: a void function that never returns early
void f(int *p) { *p = 1; }

--- ok: a value computed and returned once
int f(int a)
{
    int r = 0;
    if (a) { r = 1; }
    return r;
}

##### rule 15.6
summary: ignored (merged)

--- bad: an empty statement as a loop body
void f(int n) { while (n--) ; } /*@V*/

--- ok: macro supplies the braces
#define DO_TWICE(x) { x; x; }
void g(void);
void f(int a) { if (a) DO_TWICE(g()) }

--- ok: else block containing a nested if
void f(int a, int b)
{
    if (a) { b = 1; } else { if (b) { b = 2; } }
}

--- bad: switch body statement without braces is invalid C; a case body is fine
void f(int a)
{
    for (a = 0; a < 2; a++) a++; /*@V*/
}

##### rule 15.7
summary: ignored (merged)

--- ok: a lone if without else
void f(int a) { if (a) { a = 1; } }

--- ok: an if inside the else block is a separate statement
void f(int a, int b)
{
    if (a) { a = 1; } else { if (b) { b = 1; } }
}

--- bad: else-if chain of three without a plain else
void f(int a)
{
    if (a == 1) { a = 0; } /*@V*/
    else if (a == 2) { a = 1; }
    else if (a == 3) { a = 2; }
}

--- ok: a chain that ends with else
void f(int a)
{
    if (a == 1) { a = 0; }
    else if (a == 2) { a = 1; }
    else { a = 2; }
}

##### rule 16.1
summary: ignored (merged)

--- ok: default listed first
void f(int v)
{
    switch (v)
    {
        default:
            break;
        case 1:
            v = 2;
            break;
    }
}

--- bad: switch with a single clause
void f(int v)
{
    switch (v)
    {
        default: v = 1; break;
    }
}

##### rule 16.2
summary: ignored (merged)

--- bad: a case in a loop inside the switch (Duff's device)
void f(int v, int n)
{
    switch (v)
    {
        case 0:
            while (n--)
            {
        case 1: /*@V*/
                v++;
            }
            break;
        default:
            break;
    }
}

--- ok: nested switch has its own top-level labels
void f(int a, int b)
{
    switch (a)
    {
        case 1:
            switch (b) { case 1: b = 0; break; default: break; }
            break;
        default:
            break;
    }
}

##### rule 16.3
summary: ignored (merged)

--- bad: a clause ending with a conditional break only
void f(int v, int c)
{
    switch (v)
    {
        case 1:
            if (c) { break; } else { break; }
        default:
            break;
    }
}

--- bad: the last clause without break
void f(int v)
{
    switch (v)
    {
        case 1: v = 0; break;
        default: v = 1;
    }
}

--- ok: stacked labels sharing a clause
void f(int v)
{
    switch (v)
    {
        case 1:
        case 2:
            v = 0;
            break;
        default:
            break;
    }
}

--- bad: a clause ending with goto
void f(int v)
{
    switch (v)
    {
        case 1: goto out;
        default: break;
    }
out:
    v = 0;
}

##### rule 16.4
summary: ignored (merged)

--- bad: an enum switch covering all enumerators without default
enum e { A, B };
void f(enum e v)
{
    switch (v) /*@V*/
    {
        case A: break;
        case B: break;
    }
}

--- ok: default first
void f(int v)
{
    switch (v)
    {
        default: break;
        case 1: break;
    }
}

##### rule 16.5
summary: ignored (merged)

--- ok: only a default and a case with default last
void f(int v)
{
    switch (v)
    {
        case 1: break;
        case 2: break;
        default: break;
    }
}

--- bad: default between cases
void f(int v)
{
    switch (v) /*@V*/
    {
        case 1: break;
        default: break;
        case 2: break;
    }
}

##### rule 16.6
summary: ignored (merged)

--- bad: two labels stacked on one clause only
void f(int v)
{
    switch (v) /*@V*/
    {
        case 1:
        case 2:
            v = 0;
            break;
    }
}

--- ok: a case clause and a default clause
void f(int v)
{
    switch (v)
    {
        case 1: v = 0; break;
        default: break;
    }
}

##### rule 16.7
summary: ignored (merged)

--- bad: negation as the controlling expression
void f(int v)
{
    switch (!v) /*@V*/
    {
        case 0: break;
        default: break;
    }
}

--- ok: character controlling expression
void f(char c)
{
    switch (c)
    {
        case 'a': break;
        default: break;
    }
}

--- ok: enum controlling expression
enum e { A, B };
void f(enum e v)
{
    switch (v)
    {
        case A: break;
        default: break;
    }
}
