##### rule 13.1
summary: Reports an initializer-list element that has side effects.
limits: Only side effects that the compiler front end can see in the element expression are found.

--- ok: constants and pure expressions
int base = 2;
int a[3] = { 1, 2, 3 };
int b[2] = { 4, 5 };

--- ok: a pure expression in a local initializer
int f(int x) { int arr[2] = { x, x + 1 }; return arr[0] + arr[1]; }

--- bad: an increment in an initializer list
int f(int i)
{
    int arr[2] = { i++, 0 }; /*@V*/
    return arr[0];
}

--- bad: an assignment in an initializer list
int g(int i)
{
    int arr[2] = { i = 1, 0 }; /*@V*/
    return arr[0];
}

--- bad: a call with side effects in an initializer list
int next(void);
int h(void)
{
    int arr[2] = { next(), 0 }; /*@V*/
    return arr[0];
}

##### rule 13.2
summary: Subset: reports a scalar variable that is modified and also read or modified without an intervening sequence point in one full expression.
limits: Only plain scalar variables are tracked; calls that modify through pointers and array elements with computed indexes are not.

--- ok: a modification in its own statement
int f(int i) { i = i + 1; return i; }

--- ok: separated by sequence points
int g(int a, int b) { return (a > 0) && (b++ > 0); }

--- bad: read and modified in one expression
int f(int i)
{
    i = i++ + 1; /*@V*/
    return i;
}

--- bad: two modifications of the same variable
int g(int i)
{
    int r = i++ + i++; /*@V*/
    return r;
}

--- bad: index uses a variable that the same expression modifies
int h(int i, int *a)
{
    a[i] = i++; /*@V*/
    return a[0];
}

##### rule 13.3
summary: Reports an increment or decrement that is not a whole expression statement and shares its full expression with another side effect.
limits: A bare statement i++; is accepted. A single increment used for its value without another side effect in the expression is accepted.

--- ok: increments as statements
void f(int *p) { int i = 0; i++; --i; (*p)++; }

--- ok: an increment in a for statement clause
int g(int n) { int s = 0; int i; for (i = 0; i < n; i++) { s += i; } return s; }

--- bad: increment combined with an assignment
int f(int i)
{
    int x;
    x = i++; /*@V*/
    return x + i;
}

--- bad: increment inside an index expression
int g(int *a, int i)
{
    a[i++] = 0; /*@V*/
    return i;
}

--- bad: decrement combined with a call
void use(int);
void h(int i) { use(i--); } /*@V*/

##### rule 13.4
summary: Reports an assignment whose result is used by an enclosing expression or condition.
limits: Assignments that stand alone as expression statements are accepted; the initialization of a declaration is not an assignment expression.

--- ok: assignment statements
void f(void)
{
    int a;
    int b;
    a = 1;
    b = a;
    (void)b;
}

--- ok: a for statement clause that assigns
void g(void) { int i; for (i = 0; i < 3; i++) { } }

--- bad: assignment used as a condition
int f(int v)
{
    int x;
    if ((x = v) != 0) { return x; } /*@V*/
    return 0;
}

--- bad: chained assignment
void g(void)
{
    int a, b;
    a = b = 0; /*@V*/
    (void)a;
}

--- bad: assignment inside an argument
void use(int);
void h(int v)
{
    int x;
    use(x = v); /*@V*/
}

##### rule 13.5
summary: Reports a right operand of && or || that has side effects, including calls and volatile accesses.
limits: A call is assumed to have side effects. Reading a volatile object counts as a persistent side effect (the FreeRTOS authors rewrite such code, so the strict reading is followed).

--- ok: pure right operands
int f(int a, int b) { return a > 0 && b > 0; }
int g(int a, int b, int c) { return a || (b + c > 1); }

--- bad: a call on the right
int check(void);
int f(int a) { return a && check(); } /*@V*/

--- bad: an increment on the right
int g(int a, int b) { return a || b++; } /*@V*/

--- bad: an assignment on the right
int h(int a, int b) { return a && (b = 1); } /*@V*/

--- bad: a volatile read on the right
volatile int status;
int k(int a) { return a && status; } /*@V*/

##### rule 13.6
summary: Reports a sizeof operand expression that has side effects.
limits: Only the unevaluated expression form is examined.

--- ok: sizeof of types and of pure expressions
unsigned long a = sizeof(int);
int arr[4];
unsigned long b = sizeof(arr);
unsigned long c(int i) { return sizeof(arr[i]); }

--- bad: increment inside sizeof
unsigned long f(int i) { return sizeof(i++); } /*@V*/

--- bad: assignment inside sizeof
unsigned long g(int i) { return sizeof(i = 2); } /*@V*/

--- bad: call inside sizeof
int next(void);
unsigned long h(void) { return sizeof(next()); } /*@V*/

##### rule 14.1
summary: Reports a for loop whose increment expression modifies a floating-point variable (a floating-point loop counter).
limits: Only for loops are examined, not while loops that use a float.

--- ok: integer counter
void f(void) { int i; for (i = 0; i < 10; i++) { } }

--- ok: a floating-point value updated inside the body
double g(int n)
{
    double acc = 0.0;
    int i;
    for (i = 0; i < n; i++) { acc += 0.1; }
    return acc;
}

--- bad: float counter
void f(void)
{
    float x;
    for (x = 0.0f; x < 1.0f; x += 0.1f) { } /*@V*/
}

--- bad: double counter
void g(void)
{
    double d;
    for (d = 0.0; d < 1.0; d = d + 0.25) { } /*@V*/
}

##### rule 14.2
summary: Subset: reports a for statement that does not have exactly one loop counter that its third clause modifies, its second clause tests and its body leaves alone (the form for(;;) is accepted).
limits: Only simple counters in the clauses are recognized; counters hidden in function calls are not.

--- ok: the standard counting loop
void f(int n) { int i; for (i = 0; i < n; i++) { } }

--- ok: the infinite loop
void g(void) { for (;;) { break; } }

--- ok: a declaration-free counter in the first clause and a step
void h(int n) { int i; for (i = n; i > 0; i--) { } }

--- bad: the body modifies the counter
void f(int n)
{
    int i;
    for (i = 0; i < n; i++) /*@V*/
    {
        i++;
    }
}

--- bad: the second clause tests something else than the counter
void g(int n, int flag)
{
    int i;
    for (i = 0; flag != 0; i++) { flag--; } /*@V*/
    (void)n;
}

--- bad: no third clause
void h(int n)
{
    int i = 0;
    for (; i < n; ) { i++; } /*@V*/
}

--- bad: two counters modified in the third clause
void k(int n)
{
    int i, j;
    for (i = 0, j = 0; i < n; i++, j++) { } /*@V*/
}

##### rule 14.3
summary: Subset: reports if, do, conditional-operator and false while/for conditions that evaluate to a constant outside macro expansions.
limits: while(1) and for(;;) infinite loops are accepted. Conditions in macros are skipped. Only constants the compiler folds are found.

--- ok: variable conditions
int f(int x) { if (x > 0) { return 1; } return 0; }

--- ok: infinite loops and the do-while-zero idiom inside a macro
#define ONCE(stmt) do { stmt; } while (0)
void g(int *p) { for (;;) { break; } ONCE(*p = 1); }

--- bad: a constant condition in an if
int f(void)
{
    if (1) { return 1; } /*@V*/
    return 0;
}

--- bad: a constant conditional operator
int g(void) { return 0 ? 1 : 2; } /*@V*/

--- bad: a false loop condition
void h(void)
{
    while (0) { } /*@V*/
}

--- gap: a constant that is folded only through a configuration macro (conditions from macro expansions are skipped)
#define LIMIT 4
int k(void)
{
    if (LIMIT > 10) { return 1; } /*@V*/
    return 0;
}

##### rule 14.4
summary: Reports an if, loop or conditional-operator condition that is not essentially Boolean (a relational, equality, logical or negation expression, or a _Bool).
limits: Only controlling expressions are examined; operands of && and || are Rule 10.1's concern.

--- ok: essentially Boolean conditions
int f(int x, _Bool flag) { if (x > 0) { return 1; } while (x != 0) { x--; } return flag ? 2 : 3; }

--- ok: negation and logical operators
int g(int a, int b) { if (!a) { return 1; } if (a && b) { return 2; } return 0; }

--- bad: an integer as a condition
int f(int x)
{
    if (x) { return 1; } /*@V*/
    return 0;
}

--- bad: a pointer as a condition
int g(int *p)
{
    while (p) { p = 0; } /*@V*/
    return 0;
}

--- bad: an integer as the condition of the conditional operator
int h(int x) { return x ? 1 : 2; } /*@V*/

##### rule 15.1
summary: Reports every explicit goto statement written in the main file.
limits: A goto produced by a macro expansion is reported at the use.

--- ok: no goto
int f(int x) { return x + 1; }

--- ok: a label is not a goto
void g(void)
{
    int i = 0;
again:
    i++;
    (void)i;
}

--- bad: a forward goto
int f(int x)
{
    if (x) { goto done; } /*@V*/
    x = 1;
done:
    return x;
}

--- bad: a backward goto
void g(void)
{
    int i = 0;
again:
    i++;
    if (i < 3) { goto again; } /*@V*/
}

##### rule 15.2
summary: Reports a goto whose label is declared earlier in the function (a backward jump).
limits: Needs a successfully parsed translation unit with the label resolved.

--- ok: only forward jumps
int f(int x)
{
    if (x) { goto done; }
    x = 1;
done:
    return x;
}

--- ok: no goto at all
int g(int x) { return x; }

--- bad: a backward jump
void f(void)
{
    int i = 0;
again:
    i++;
    if (i < 3) { goto again; } /*@V*/
}

--- bad: a backward jump out of a nested block
void g(int n)
{
top:
    n--;
    if (n > 0)
    {
        goto top; /*@V*/
    }
}

##### rule 15.3
summary: Reports a goto whose label is not declared in the same block as the goto or in an enclosing block.
limits: Needs a successfully parsed translation unit with the label resolved.

--- ok: label in the same block
void f(int x)
{
    if (x) { goto end; }
    x = 1;
end:
    return;
}

--- ok: label in an enclosing block
void g(int x)
{
    {
        if (x) { goto end; }
    }
end:
    return;
}

--- bad: a jump into a nested block
void f(int x)
{
    goto inside; /*@V*/
    {
inside:
        x = 1;
    }
}

--- bad: a jump into a sibling block
void g(int x)
{
    if (x)
    {
        goto other; /*@V*/
    }
    else
    {
other:
        x = 2;
    }
}

##### rule 15.4
summary: Reports a for, while or do loop that has more than one break or goto leaving it.
limits: Only the loops written in the main file are examined. A break in a nested switch belongs to the switch.

--- ok: a loop with one break
int f(int n)
{
    int i;
    for (i = 0; i < n; i++) { if (i == 5) { break; } }
    return i;
}

--- ok: no break
void g(int n) { while (n > 0) { n--; } }

--- ok: a break that belongs to an inner switch
void h(int n)
{
    while (n > 0)
    {
        switch (n) { case 1: break; default: break; }
        n--;
    }
}

--- bad: two breaks
int f(int n)
{
    int i;
    for (i = 0; i < n; i++) /*@V*/
    {
        if (i == 5) { break; }
        if (i == 7) { break; }
    }
    return i;
}

--- bad: a break and a goto out of the loop
int g(int n)
{
    int i;
    for (i = 0; i < n; i++) /*@V*/
    {
        if (i == 5) { break; }
        if (i == 7) { goto out; }
    }
out:
    return i;
}

##### rule 15.5
summary: Reports a function with more than one return statement, or whose single return is not the last statement of the body.
limits: Functions of void type with a bare return are examined the same way.

--- ok: a single return at the end
int f(int x) { int r = x; if (x > 0) { r = 1; } return r; }

--- ok: a function without any return
void g(void) { }

--- bad: two returns
int f(int x) /*@V*/
{
    if (x > 0) { return 1; }
    return 0;
}

--- bad: a return that is not the last statement
int g(int x) /*@V*/
{
    return x;
    x = 1;
}

--- bad: an early return in a void function
void h(int x) /*@V*/
{
    if (x) { return; }
    x = 1;
}

##### rule 15.6
summary: Reports an if, else, loop or switch body that is not a compound statement (an else-if chain is accepted).
limits: Only the bodies are examined, not the layout.

--- ok: bodies in braces
void f(int x) { if (x) { x = 1; } else { x = 2; } while (x > 0) { x--; } }

--- ok: an else-if chain
int g(int x) { if (x == 1) { return 1; } else if (x == 2) { return 2; } else { return 3; } }

--- bad: an if body without braces
void f(int x)
{
    if (x) x = 1; /*@V*/
}

--- bad: a loop body without braces
void g(int n)
{
    while (n > 0) n--; /*@V*/
}

--- bad: an else body without braces
void h(int x)
{
    if (x) { x = 1; } else x = 2; /*@V*/
}

##### rule 15.7
summary: Reports an if / else-if chain that does not end in a plain else.
limits: A lone if without else-if is accepted.

--- ok: a lone if
void f(int x) { if (x) { x = 1; } }

--- ok: a chain ending in else
int g(int x) { if (x == 1) { return 1; } else if (x == 2) { return 2; } else { return 3; } }

--- bad: a chain without a final else
int f(int x)
{
    if (x == 1) { return 1; } /*@V*/
    else if (x == 2) { return 2; }
    return 0;
}

--- bad: a longer chain without a final else
void g(int x)
{
    if (x == 1) { x = 0; } /*@V*/
    else if (x == 2) { x = 1; }
    else if (x == 3) { x = 2; }
}

##### rule 16.1
summary: Reports any violation of the structure rules for switch statements (labels at the top level of the body, a break per clause, default placement, clause count, and an essentially non-Boolean controlling expression).
limits: A summary rule that overlaps 16.2 to 16.7; those individual rules are reported as well.

--- ok: a well formed switch
int f(int v)
{
    int r;
    switch (v)
    {
        case 1:
            r = 10;
            break;
        case 2:
            r = 20;
            break;
        default:
            r = 0;
            break;
    }
    return r;
}

--- bad: a clause that falls through
int f(int v)
{
    int r = 0;
    switch (v)
    {
        case 1: /*@V*/
            r = 1;
        case 2:
            r = 2;
            break;
        default:
            break;
    }
    return r;
}

--- bad: a switch without default
int g(int v)
{
    int r = 0;
    switch (v) /*@V*/
    {
        case 1:
            r = 1;
            break;
        case 2:
            r = 2;
            break;
    }
    return r;
}

##### rule 16.2
summary: Reports a case or default label that is not a top-level clause of its switch body.
limits: Only labels nested in blocks inside the switch body are reported.

--- ok: top-level labels
int f(int v) { switch (v) { case 1: return 1; default: return 0; } }

--- bad: a case label inside a nested block
int f(int v)
{
    int r = 0;
    switch (v)
    {
        case 1:
            r = 1;
            break;
        default:
            {
            case 2: /*@V*/
                r = 2;
            }
            break;
    }
    return r;
}

--- bad: a label inside an if within the switch
int g(int v)
{
    switch (v)
    {
        case 1:
            if (v > 0)
            {
        case 3: /*@V*/
                return 3;
            }
            return 1;
        default:
            return 0;
    }
}

##### rule 16.3
summary: Strict reading: reports a switch clause whose last statement is not a break (or a block ending in break).
limits: Consecutive empty labels sharing a clause are accepted. A clause that ends in return or goto is reported under the strict reading.

--- ok: every clause ends in break
int f(int v)
{
    int r;
    switch (v)
    {
        case 1: r = 1; break;
        case 2: r = 2; break;
        default: r = 0; break;
    }
    return r;
}

--- ok: stacked labels
int g(int v)
{
    int r;
    switch (v)
    {
        case 1:
        case 2:
            r = 5;
            break;
        default:
            r = 0;
            break;
    }
    return r;
}

--- bad: a clause that falls through
int f(int v)
{
    int r = 0;
    switch (v)
    {
        case 1: /*@V*/
            r = 1;
        case 2:
            r = 2;
            break;
        default:
            break;
    }
    return r;
}

--- bad: a clause that ends in return (strict reading)
int g(int v)
{
    switch (v)
    {
        case 1: /*@V*/
            return 1;
        default:
            break;
    }
    return 0;
}

##### rule 16.4
summary: Reports a switch statement without a default label.
limits: Only the presence of a default label is examined.

--- ok: a switch with default
int f(int v) { switch (v) { case 1: return 1; default: return 0; } }

--- bad: no default
int f(int v)
{
    int r = 0;
    switch (v) /*@V*/
    {
        case 1: r = 1; break;
        case 2: r = 2; break;
    }
    return r;
}

--- bad: only a case label
int g(int v)
{
    switch (v) /*@V*/
    {
        case 1:
            return 1;
    }
    return 0;
}

##### rule 16.5
summary: Reports a switch whose default clause is neither the first nor the last clause.
limits: A switch without default is Rule 16.4.

--- ok: default last
int f(int v) { switch (v) { case 1: return 1; case 2: return 2; default: return 0; } }

--- ok: default first
int g(int v) { switch (v) { default: return 0; case 1: return 1; case 2: return 2; } }

--- bad: default in the middle
int f(int v)
{
    switch (v) /*@V*/
    {
        case 1: return 1;
        default: return 0;
        case 2: return 2;
    }
}

##### rule 16.6
summary: Reports a switch statement with fewer than two clauses.
limits: A clause with several stacked labels counts once.

--- ok: two clauses
int f(int v) { switch (v) { case 1: return 1; default: return 0; } }

--- bad: only a default clause
int f(int v)
{
    switch (v) /*@V*/
    {
        default: return v;
    }
}

--- bad: a single case clause
int g(int v)
{
    switch (v) /*@V*/
    {
        case 1: return 1;
    }
    return 0;
}

##### rule 16.7
summary: Reports a switch whose controlling expression is essentially Boolean.
limits: Only the type of the controlling expression is examined.

--- ok: an integer controlling expression
int f(int v) { switch (v) { case 1: return 1; default: return 0; } }

--- bad: a comparison as the controlling expression
int f(int a, int b)
{
    switch (a == b) /*@V*/
    {
        case 0: return 0;
        default: return 1;
    }
}

--- bad: a _Bool controlling expression
int g(_Bool flag)
{
    switch (flag) /*@V*/
    {
        case 0: return 0;
        default: return 1;
    }
}
